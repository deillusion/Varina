{
  "version": "agent-1.0-grounded-dialogue",
  "models": [
    {
      "id": "DEEPSEEK",
      "model": "deepseek-flash",
      "baseUrl": "https://api.deepseek.com",
      "apiKeyEnv": "DEEPSEEK_API_KEY",
      "structuredOutput": "json_object",
      "tokenParameter": "max_tokens",
      "supportsTemperature": true,
      "supportsReasoning": true,
      "supportsSeed": false,
      "inputPricePerMillion": null,
      "outputPricePerMillion": null,
      "protocol": "chat"
    },
    {
      "id": "GLM",
      "model": "GLM-5.3-Flash",
      "baseUrl": "https://open.bigmodel.cn/api/paas/v4",
      "apiKeyEnv": "GLM_API_KEY",
      "structuredOutput": "json_object",
      "tokenParameter": "max_tokens",
      "supportsTemperature": true,
      "supportsReasoning": true,
      "supportsSeed": false,
      "inputPricePerMillion": null,
      "outputPricePerMillion": null,
      "protocol": "chat",
      "reasoningEffortMap": {
        "medium": "high",
        "none": "low"
      }
    },
    {
      "id": "GEMINI",
      "model": "gemini-3.7-flash",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
      "apiKeyEnv": "GEMINI_API_KEY",
      "structuredOutput": "json_schema",
      "tokenParameter": "max_tokens",
      "supportsTemperature": true,
      "supportsReasoning": true,
      "supportsSeed": false,
      "inputPricePerMillion": null,
      "outputPricePerMillion": null,
      "protocol": "chat",
      "maxOutputTokens": 65536
    }
  ],
  "seats": [
    {
      "id": "Z1",
      "modelId": "GLM"
    },
    {
      "id": "Z2",
      "modelId": "GLM"
    },
    {
      "id": "Z3",
      "modelId": "GLM"
    },
    {
      "id": "G1",
      "modelId": "GEMINI"
    },
    {
      "id": "G2",
      "modelId": "GEMINI"
    },
    {
      "id": "G3",
      "modelId": "GEMINI"
    },
    {
      "id": "G4",
      "modelId": "GEMINI"
    },
    {
      "id": "G5",
      "modelId": "GEMINI"
    }
  ],
  "roles": {
    "main": "GEMINI",
    "exploration": "GEMINI",
    "varina_gate": "DEEPSEEK",
    "baseline_extraction": "DEEPSEEK",
    "varina_delta": "GEMINI",
    "compaction": "GEMINI"
  },
  "generation": {
    "agent": {
      "temperature": 0.3,
      "reasoning_effort": "low",
      "max_output_tokens": 16384
    },
    "creative": {
      "temperature": 1,
      "reasoning_effort": "low",
      "max_output_tokens": 131072
    },
    "varina_gate": {
      "temperature": 0,
      "reasoning_effort": "low",
      "max_output_tokens": 512
    },
    "varina_delta": {
      "temperature": 0.3,
      "reasoning_effort": "low",
      "max_output_tokens": 16384
    }
  },
  "decisionProviders": {
    "jev": {
      "enabled": true,
      "baseUrl": "https://api.typesafe.ai",
      "model": "jev-latest",
      "apiKeyEnv": "TYPESAFE_API_KEY",
      "timeoutMs": 30000,
      "retries": 2,
      "askProbabilityThreshold": 0.9,
      "askConfidenceThreshold": 0.8,
      "subproblemDuplicateThreshold": 0.85
    }
  },
  "decomposition": {
    "enabled": true,
    "seatCount": 5,
    "maxRounds": 3,
    "maxQuestionsPerSeat": 4,
    "maxAcceptedSubproblems": 20
  },
  "subproblemExpansion": {
    "enabled": true,
    "answersPerSubproblem": 2,
    "maxElementsPerAnswer": 3
  },
  "exploration": {
    "rounds": 5,
    "maxReactSteps": 100,
    "maxContextChars": 1000000
  },
  "retries": 2,
  "timeoutMs": 180000,
  "retryDelayMs": 5000,
  "max_tool_iterations": 100
}
